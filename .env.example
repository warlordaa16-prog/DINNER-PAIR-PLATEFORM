# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic secret for signing session tokens (set a strong random string in production).
SESSION_SECRET="change_me_to_a_long_random_secret_string"

# ADMIN_BOOTSTRAP_USERNAME / EMAIL / PASSWORD: Initial administrator account created on first boot if none exists.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_EMAIL="admin@dinnerpair.app"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMeDinnerPair2026!"

# DB_PATH: File path for local SQLite persistence (default: ./data/dinner_pair.sqlite)
DB_PATH="./data/dinner_pair.sqlite"

# DATABASE_URL: PostgreSQL connection string for external Supabase/Neon production deployment via Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/dinner_pair?schema=public"

# SMS_WEBHOOK_URL: Optional webhook endpoint for dispatching participant verification codes via SMS/WhatsApp
SMS_WEBHOOK_URL=""

